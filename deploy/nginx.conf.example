# Example reverse-proxy config for your existing nginx.
# Place in /etc/nginx/sites-available/kledingkast and symlink into sites-enabled,
# then `sudo nginx -t && sudo systemctl reload nginx`.
#
# For HTTPS, run certbot afterwards:  sudo certbot --nginx -d kast.jouwdomein.nl

server {
    listen 80;
    server_name kast.jouwdomein.nl;   # <-- pas aan

    # Allow phone-camera photos up to the app's upload limit (+ margin).
    client_max_body_size 20M;

    # The app sends its own CSP, Referrer-Policy, X-Frame-Options and
    # X-Content-Type-Options, so there is nothing to add here. HSTS it sends
    # only when you ask for it (WARDROBE_HSTS_SECONDS), because the promise
    # outlives a broken certificate. Once certbot has run and you are happy on
    # https, pick one of the two — here:
    #
    #   add_header Strict-Transport-Security "max-age=31536000" always;
    #
    # or in the app, with WARDROBE_HSTS_SECONDS=31536000. Not both.

    location / {
        proxy_pass         http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        # X-Forwarded-Proto is what tells the app it is reached over https, and
        # therefore whether to mark its cookies Secure and whether HSTS applies.
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   X-Forwarded-Host  $host;
    }
}
