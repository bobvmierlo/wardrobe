# Copy to .env and adjust. docker-compose reads this automatically.
#
# Alleen wat je hier écht zet komt in de container terecht; al het andere blijft
# de ingebouwde standaard uit app/config.py. Bij het opstarten zet de app elke
# instelling in het logboek, met erbij of 'ie uit je .env komt of de standaard
# is — dus je hoeft niet te gokken of dit bestand gelezen wordt.

# REQUIRED. Sign-in tokens are signed with this. Generate one with:
#   openssl rand -hex 32
WARDROBE_SECRET_KEY=change-me-to-a-long-random-string

# Bootstrap admin account. Created only on the very first startup (empty DB).
# Log in with these, then change the password in the app under Instellingen.
WARDROBE_ADMIN_USERNAME=admin
WARDROBE_ADMIN_PASSWORD=changeme
WARDROBE_ADMIN_DISPLAY_NAME=Beheerder

# Max photo upload size in MB.
WARDROBE_MAX_UPLOAD_MB=15

# How chatty the log is: DEBUG, INFO, WARNING or ERROR. INFO logs every change
# (who added/approved what) plus warnings and errors; DEBUG adds every read.
# The same lines appear in `docker compose logs` and in the app under
# Instellingen → Logboek.
WARDROBE_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Beveiliging
# ---------------------------------------------------------------------------
# Alle standaarden hieronder zijn al de veilige keuze; je hoeft hier niets in te
# vullen. Ze staan er zodat je ze kúnt bijstellen.

# Na dit aantal mislukte inlogpogingen op rij volgt een 429. De wachttijd
# begint bij LOCKOUT_SECONDS en verdubbelt per verdere poging tot 15 minuten.
# Een goed wachtwoord wist de teller meteen.
#WARDROBE_LOGIN_MAX_ATTEMPTS=5
#WARDROBE_LOGIN_LOCKOUT_SECONDS=30

# Kortste wachtwoord dat de app accepteert als er één wordt ingesteld.
# Verhogen sluit niemand buiten: bestaande wachtwoorden blijven werken en
# komen dit pas tegen als ze worden gewijzigd.
#WARDROBE_MIN_PASSWORD_LENGTH=8

# Browsers die de API vanaf een ánder adres mogen aanroepen (komma's ertussen).
# Leeg = geen, en dat is voor vrijwel elke installatie het juiste antwoord: de
# app serveert z'n eigen frontend, en de Vite-dev-server proxyt /api.
#WARDROBE_CORS_ORIGINS=

# Secure-vlag op de fotocookie. "auto" kijkt per verzoek: aan op https, uit op
# gewone http (waar een secure cookie simpelweg nooit verstuurd wordt en dus
# elke foto zou breken). "true"/"false" dwingen het af.
#WARDROBE_COOKIE_SECURE=auto

# Content-Security-Policy. De standaard houdt alles op dit ene adres, wat de
# sterkste bescherming is voor een token dat in localStorage leeft. Leeg maken
# stuurt geen policy (bv. als je reverse-proxy er zelf één zet).
#WARDROBE_CONTENT_SECURITY_POLICY=

# HSTS, in seconden, alleen verstuurd op https. Uit (0) omdat dit een belofte
# is die de browser een jaar onthoudt: zet 'm pas aan als je certificaat staat.
#WARDROBE_HSTS_SECONDS=31536000

# Mogen de foto-URL- en webshop-importfuncties adressen in je eigen netwerk
# ophalen? Uit, want die functies nemen een URL aan van elke ingelogde
# gebruiker, en de server staat op hetzelfde netwerk als de rest van je spullen.
#WARDROBE_FETCH_ALLOW_PRIVATE=false

# ---------------------------------------------------------------------------
# Weer
# ---------------------------------------------------------------------------
# De app haalt de echte weersverwachting op voor de plek die een gebruiker
# kiest, zodat "Vandaag" kan zeggen wat je aan zou kunnen trekken. Dat gebeurt
# via diensten die géén account en géén API-sleutel vragen, en altijd vanaf de
# server — je browser praat zelf nooit met een weerdienst.
#
# Uit? Dan blijven de weerschermen werken, maar zet iedereen het weer zelf
# handmatig in. Doen als je server niet naar buiten mag.
#WARDROBE_WEATHER_ENABLED=true

# Open-Meteo: de verwachting, en het zoeken op plaatsnaam. Allebei open source,
# dus je kunt ze desgewenst naar je eigen installatie wijzen.
#WARDROBE_WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
#WARDROBE_GEOCODING_API_URL=https://geocoding-api.open-meteo.com/v1/search

# Zippopotam: het zoeken op postcode, wat de geocoder hierboven voor Nederlandse
# postcodes niet betrouwbaar doet.
#WARDROBE_POSTCODE_API_URL=https://api.zippopotam.us
# In welk land een kale postcode ("5421") verondersteld wordt te liggen.
#WARDROBE_WEATHER_COUNTRY=nl

# Hoe lang een opgehaalde verwachting hergebruikt wordt. Het weer verandert niet
# in een minuut, en iedereen in huis die 's ochtends kijkt hoort samen één
# verzoek te zijn aan een dienst die er niets voor terugvraagt.
#WARDROBE_WEATHER_CACHE_MINUTES=15

# ---------------------------------------------------------------------------
# AI (optioneel, standaard uit)
# ---------------------------------------------------------------------------
# Zonder dit doet de app alles zelf: de knoppen onder "Je kast laten aanvullen"
# leiden tags af uit categorie en naam, en stellen looks samen met de
# kleurregels van deze installatie. Dat blijft ook werken als je dit aanzet —
# de AI vult alleen in wáár die regels niets te zeggen hebben, en alles wat
# terugkomt gaat alsnog langs dezelfde woordenlijsten.
#
# Aanzetten betekent dat de server bij het indrukken van zo'n knop naam,
# categorie, kleur, maat en seizoen van de betrokken kledingstukken naar
# Anthropic stuurt. Geen foto's, geen namen van personen. Uit = er gaat niets
# de deur uit, en de knop met AI verschijnt niet eens in de app.
#WARDROBE_AI_ENABLED=false
#WARDROBE_AI_API_KEY=sk-ant-...

# Welk model. Standaard het sterkste; een goedkoper model kan hier prima —
# dit is invulwerk, geen redeneerwerk.
#WARDROBE_AI_MODEL=claude-opus-5
# Hoeveel denkwerk het model erin steekt: low, medium, high, xhigh of max.
#WARDROBE_AI_EFFORT=low
#WARDROBE_AI_TIMEOUT_SECONDS=60

# Weigert het model een vraag, dan draait dezelfde vraag binnen hetzelfde
# verzoek op een terugvalmodel. Uit te zetten voor een opstelling (of proxy)
# die de bijbehorende beta-vlag niet accepteert.
#WARDROBE_AI_REFUSAL_FALLBACK=true

# ---------------------------------------------------------------------------
# Automatische back-ups
# ---------------------------------------------------------------------------
# Tijd waarop de app elke dag een momentopname in <data>/backups zet, als UU:MM
# in de tijdzone van de container (zet TZ om die te verschuiven). Leeg = uit,
# want op een schema bestanden op iemands schijf zetten doe je niet ongevraagd.
#
# Een momentopname en geen export: die bevat de database zelf, dus zet álles
# terug (accounts, uitnodigingen, logboek, catalogus) in plaats van alleen de
# inhoud van een kast. Terugzetten gaat met een bestandskopie, niet via de app
# — zie de README.
#WARDROBE_BACKUP_TIME=03:30

# Hoeveel er bewaard blijven. Wat ouder is wordt na elke ronde verwijderd.
# Bestanden die jij zelf in die map zet blijven staan.
#WARDROBE_BACKUP_KEEP=7

# Draai de opruimcontrole (zoekt resten van half verwijderde accounts) ook als
# de database al bij is. Normaal loopt die één keer, als migratie. Handig nadat
# je een back-up met de hand hebt teruggezet. Zet 'm daarna weer uit.
#WARDROBE_REPAIR_ON_START=false

# ---------------------------------------------------------------------------
# Inloggen via SSO (OpenID Connect) — optioneel
# ---------------------------------------------------------------------------
# Werkt met Authentik, Authelia, Keycloak, Zitadel, Pocket ID, Entra ID,
# Google en alles wat OpenID Connect spreekt. Zie de README voor een
# stap-voor-stap per provider.
#
# Inloggen met gebruikersnaam en wachtwoord blijft hier ALTIJD naast staan.
# Dat is met opzet: als je provider onbereikbaar is, moet je er nog in kunnen.

#WARDROBE_OIDC_ENABLED=true

# Het adres waarop jij de app bereikt. Nodig omdat de redirect-URI exact moet
# matchen met wat je bij je provider registreert.
#WARDROBE_PUBLIC_URL=https://kast.jouwdomein.nl

# De issuer (de basis-URL; /.well-known/openid-configuration wordt er zelf
# achter gezet), plus de client-gegevens van de toepassing die je daar maakt.
#WARDROBE_OIDC_ISSUER=https://auth.jouwdomein.nl/application/o/kledingkast/
#WARDROBE_OIDC_CLIENT_ID=
#WARDROBE_OIDC_CLIENT_SECRET=

# Groepen zitten niet in de standaard-scopes, vandaar "groups".
#WARDROBE_OIDC_SCOPES=openid profile email groups

# Welke claim de groepen bevat. Een punt gaat een niveau dieper, bv.
# "realm_access.roles" voor Keycloak.
#WARDROBE_OIDC_GROUPS_CLAIM=groups

# Wie in deze groep zit, is beheerder. Wie er niet in zit, is een gewone
# gebruiker — dat wordt bij ELKE SSO-login opnieuw toegepast. Leeg laten
# betekent: laat de rollen zoals je ze in de app zelf instelt.
#WARDROBE_OIDC_ADMIN_GROUP=kledingkast-admins

# Optioneel: alleen leden van deze groepen mogen naar binnen (komma's ertussen).
#WARDROBE_OIDC_ALLOWED_GROUPS=kledingkast-users

# Uit = alleen op uitnodiging, ook via SSO: wie nog geen account heeft, heeft
# een uitnodigingslink nodig. Aan = iedereen die je provider binnenlaat krijgt
# meteen een account (en een eigen kast).
#WARDROBE_OIDC_AUTO_CREATE=false

# Eenmalig nodig om bestaande accounts van vóór SSO over te zetten: koppelt op
# gelijke gebruikersnaam. Zet 'm daarna weer uit.
#WARDROBE_OIDC_LINK_BY_USERNAME=false

# De tekst op de knop.
#WARDROBE_OIDC_BUTTON_LABEL=Inloggen met Authentik

# Uitloggen hier ook afmelden bij de provider zelf?
#WARDROBE_OIDC_LOGOUT_REDIRECT=false

# Op false staat het wachtwoordformulier dichtgeklapt op het inlogscherm (je
# kunt het met één klik alsnog openen). Het blijft altijd werken — dat is de
# noodingang als je provider onbereikbaar is.
#WARDROBE_LOCAL_LOGIN=true
